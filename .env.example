# Copy this file to .env and fill in real values. Never commit the real .env.

# ---------------------------------------------------------------------------
# LiveKit (https://cloud.livekit.io) -- real-time audio room + agent worker
# ---------------------------------------------------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---------------------------------------------------------------------------
# Sarvam AI (https://dashboard.sarvam.ai) -- Speech-to-Text + Text-to-Speech
# ---------------------------------------------------------------------------
SARVAM_API_KEY=

# ---------------------------------------------------------------------------
# Gemma 4 -- pick ONE backend
# ---------------------------------------------------------------------------
# "google" -> call Gemma through Google AI Studio (default, no local GPU needed)
# "ollama" -> run Gemma locally (`ollama pull gemma4` first)
GEMMA_BACKEND=google

# Required when GEMMA_BACKEND=google -- get a key at https://aistudio.google.com
GOOGLE_API_KEY=
GOOGLE_MODEL=gemma-4-26b-a4b-it

# Only used when GEMMA_BACKEND=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=gemma4
